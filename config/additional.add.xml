<additional>

    <!-- ================== TYPES OF VEHICLES ================== -->

    <!-- Car -->

    <routes>

        <vType id="evehicle"
            vClass="passenger"
            energyModel="electric"
            
            length="5.0"
            width="1.8"
            height="1.5"
            mass="1850"
            minGap="2.5"

            accel="2.6"
            decel="4.5"
            emergencyDecel="9.0"
            maxSpeed="33.33"
            
            personCapacity="4"
            guiShape="evehicle"
            emissionClass="Energy/unknown">

            <param key="device.battery.probability" value="1.0"/>
            <param key="has.battery.device" value="true"/>
            <param key="device.battery.capacity" value="35000"/>
            <param key="device.battery.chargeLevel" value="17500"/>
            <param key="device.battery.maximumPowerRate" value="150000"/>
            <param key="constantPowerIntake" value="2500"/>

        </vType>

    </routes>

    <!-- Bus -->
    <routes>
        <vType id="ElectricBus"
            vClass="bus"
            energyModel="electric"
            
            length="12.0"
            width="2.5"
            height="3.4"
            mass="12000"
            minGap="2.5"

            accel="1"
            decel="4"
            emergencyDecel="7.0"
            maxSpeed="24"
            
            personCapacity="85"
            guiShape="bus"
            emissionClass="Energy/unknown">
            
            <param key="has.battery.device" value="true"/>
            <param key="device.battery.capacity" value="80000"/>
            <param key="maximumPower" value="1000"/>
            <param key="frontSurfaceArea" value="5"/>
            <param key="airDragCoefficient" value="0.6"/>
            <param key="rotatingMass" value="1000"/>
            <param key="radialDragCoefficient" value="0.5"/>
            <param key="rollDragCoefficient" value="0.01"/>
            <param key="constantPowerIntake" value="100"/>
            <param key="propulsionEfficiency" value="0.9"/>
            <param key="recuperationEfficiency" value="0.9"/>
            <param key="stoppingThreshold" value="0.1"/>
            <param key="device.battery.maximumChargeRate" value="150000"/>
        </vType>
    </routes>

